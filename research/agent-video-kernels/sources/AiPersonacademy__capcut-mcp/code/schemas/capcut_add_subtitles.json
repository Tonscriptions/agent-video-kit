{"name":"capcut_add_subtitles","description":"Batch adds synchronized subtitles / captions from an array of items, an SRT file path, or raw SRT string.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"border_color":{"default":"#000000ff","description":"Subtitle border outline color.","type":"string"},"border_width":{"default":0.08,"description":"Subtitle border outline width.","type":"number"},"font_size":{"default":10,"description":"Subtitle font size.","type":"number"},"project_name_or_id":{"description":"Target project name or ID.","type":"string"},"srt_content":{"description":"Raw SRT format text string.","type":"string"},"srt_file_path":{"description":"Absolute path to a .srt subtitle file on disk.","type":"string"},"subtitles":{"description":"Structured list of subtitle cues.","items":{"additionalProperties":false,"properties":{"endTimeSeconds":{"description":"End timestamp in seconds.","type":"number"},"startTimeSeconds":{"description":"Start timestamp in seconds.","type":"number"},"text":{"description":"Subtitle text.","type":"string"}},"required":["startTimeSeconds","endTimeSeconds","text"],"type":"object"},"type":"array"},"text_color":{"default":"#ffffffff","description":"Subtitle font color.","type":"string"},"y":{"default":-0.72,"description":"Vertical position [-1.0 to 1.0]. -0.72 is ideal lower-third position.","type":"number"}},"required":["project_name_or_id"],"type":"object"}}