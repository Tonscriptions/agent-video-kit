+/** Quiet this long, "Working" reads "Still working". */
+export const QUIET_MS = 30_000;
+/** Quiet this long, the app's own agent says it waits for the model: some think for minutes before they answer. */
+export const MODEL_WAIT_MS = 120_000;
+
+/** What the status row says when nothing is reported, after `idleMs` of quiet; `ownAgent` for the app's own agent. */
+export function idleStatus(idleMs: number, ownAgent: boolean): 'act.working' | 'act.stillWorking' | 'act.waitingForModel' {
+  if (ownAgent && idleMs >= MODEL_WAIT_MS) return 'act.waitingForModel';
+  return idleMs >= QUIET_MS ? 'act.stillWorking' : 'act.working';
+}
