{"name":"capcut_add_text","description":"Adds a customizable title, lower-third, or text overlay to a text track.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"alignment":{"default":"center","description":"Text alignment.","enum":["left","center","right"],"type":"string"},"border_color":{"default":"#000000ff","description":"Stroke/outline color (default #000000ff black).","type":"string"},"border_width":{"default":0.08,"description":"Outline border width (0.0 to 0.2).","type":"number"},"duration_seconds":{"default":3,"description":"Duration in seconds (default 3s).","type":"number"},"font_size":{"default":14,"description":"Font size (e.g. 12, 14, 18).","type":"number"},"project_name_or_id":{"description":"Target project name or ID.","type":"string"},"start_time_seconds":{"anyOf":[{"type":"number"},{"const":"auto_append","type":"string"}],"default":"auto_append","description":"Start time in seconds, or 'auto_append'."},"text":{"description":"Text content to display.","type":"string"},"text_color":{"default":"#ffffffff","description":"Hex color with alpha (default #ffffffff white).","type":"string"},"track_index":{"default":0,"description":"Text track index.","type":"number"},"x":{"default":0,"description":"Horizontal position [-1.0 to 1.0]. 0 = center.","type":"number"},"y":{"default":-0.65,"description":"Vertical position [-1.0 to 1.0]. Negative is lower third.","type":"number"}},"required":["project_name_or_id","text"],"type":"object"}}