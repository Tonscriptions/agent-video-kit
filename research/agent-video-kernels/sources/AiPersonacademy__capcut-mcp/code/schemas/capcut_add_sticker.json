{"name":"capcut_add_sticker","description":"Adds an animated sticker or graphic element to the project timeline.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"duration_seconds":{"default":3,"description":"Duration in seconds.","type":"number"},"project_name_or_id":{"description":"Target project name or ID.","type":"string"},"scale":{"default":1,"description":"Scale multiplier.","type":"number"},"start_time_seconds":{"anyOf":[{"type":"number"},{"const":"auto_append","type":"string"}],"default":"auto_append","description":"Start time on timeline in seconds, or 'auto_append'."},"sticker_name":{"description":"Name/tag of the sticker.","type":"string"},"track_index":{"default":0,"description":"Sticker track index.","type":"number"},"x":{"default":0,"description":"Horizontal position [-1.0 to 1.0].","type":"number"},"y":{"default":0,"description":"Vertical position [-1.0 to 1.0].","type":"number"}},"required":["project_name_or_id","sticker_name"],"type":"object"}}