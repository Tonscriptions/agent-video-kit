{"name":"capcut_add_audio_fade","description":"Adds smooth volume fade-in and/or fade-out envelopes to an audio track segment, eliminating abrupt audio cutoffs in background music or dialogue.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"fade_in_seconds":{"default":0,"description":"Fade-in duration in seconds (e.g. 1.5).","type":"number"},"fade_out_seconds":{"default":0,"description":"Fade-out duration in seconds (e.g. 2.0).","type":"number"},"project_name_or_id":{"description":"Target project name or ID.","type":"string"},"segment_id":{"description":"UUID of the audio segment.","type":"string"}},"required":["project_name_or_id","segment_id"],"type":"object"}}