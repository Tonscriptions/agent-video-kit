{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ad-editor.local/schemas/agent-project/0.1.0",
  "title": "AI广告剪辑 Agent Project",
  "description": "Minimal executable contract for the Agent-first video project format.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project", "settings", "assets", "sequences", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "project": {"$ref": "#/$defs/project"},
    "settings": {"$ref": "#/$defs/settings"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "sequences": {"type": "array", "items": {"$ref": "#/$defs/sequence"}},
    "templates": {"type": "array", "items": {"$ref": "#/$defs/template"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "created_at", "updated_at", "creator"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "creator": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string"}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "required": ["timebase", "canvas"],
      "properties": {
        "timebase": {
          "type": "object",
          "required": ["ticks_per_second", "display_fps"],
          "properties": {
            "ticks_per_second": {"$ref": "#/$defs/positiveInteger"},
            "display_fps": {
              "type": "object",
              "required": ["num", "den"],
              "properties": {
                "num": {"$ref": "#/$defs/positiveInteger"},
                "den": {"$ref": "#/$defs/positiveInteger"}
              }
            }
          }
        },
        "canvas": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {"$ref": "#/$defs/positiveInteger"},
            "height": {"$ref": "#/$defs/positiveInteger"},
            "pixel_aspect": {
              "type": "object",
              "required": ["num", "den"],
              "properties": {
                "num": {"$ref": "#/$defs/positiveInteger"},
                "den": {"$ref": "#/$defs/positiveInteger"}
              }
            }
          }
        },
        "color": {
          "type": "object",
          "properties": {
            "primaries": {"type": "string", "enum": ["bt709", "bt2020", "smpte170m", "smpte432"]},
            "transfer": {"type": "string", "enum": ["bt709", "bt2020-10", "smpte2084", "arib-std-b67", "iec61966-2-1", "linear"]},
            "matrix": {"type": "string", "enum": ["bt709", "bt2020nc", "bt2020c", "smpte170m", "gbr"]},
            "range": {"type": "string", "enum": ["limited", "full", "tv", "pc"]},
            "tone_map": {"type": "string", "enum": ["none", "linear", "gamma", "clip", "reinhard", "hable", "mobius"]},
            "tone_mapping": {"type": "string", "enum": ["none", "linear", "gamma", "clip", "reinhard", "hable", "mobius"]},
            "input_transfer": {"type": "string", "enum": ["bt2020-10", "bt2020-12", "smpte2084", "arib-std-b67"]},
            "input_primaries": {"type": "string", "enum": ["bt2020", "bt709"]},
            "input_matrix": {"type": "string", "enum": ["bt2020nc", "bt2020c", "bt709"]},
            "input_range": {"type": "string", "enum": ["limited", "full", "tv", "pc"]},
            "tone_map_desat": {"type": "number", "minimum": 0},
            "tone_map_peak": {"type": "number", "minimum": 0}
          }
        },
        "adjustments": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"$ref": "#/$defs/effect"},
              {
                "type": "object",
                "required": ["effects"],
                "properties": {
                  "id": {"$ref": "#/$defs/id"},
                  "enabled": {"type": "boolean"},
                  "start_tick": {"$ref": "#/$defs/nonNegativeInteger"},
                  "duration_tick": {"$ref": "#/$defs/positiveInteger"},
                  "effects": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/effect"}]}}
                }
              }
            ]
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "container": {"type": "string", "enum": ["mp4", "webm", "mkv"]},
            "video": {
              "type": "object",
              "properties": {
                "codec": {"type": "string"},
                "preset": {"type": "string"},
                "crf": {"type": "integer", "minimum": 0, "maximum": 63},
                "bitrate": {"type": "string"},
                "pixel_format": {"type": "string", "enum": ["yuv420p", "yuv422p", "yuv444p", "yuv420p10le", "yuv422p10le", "yuv444p10le", "yuva420p"]}
              }
            },
            "audio": {
              "type": "object",
              "properties": {"codec": {"type": "string"}, "bitrate": {"type": "string"}}
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "uri", "sha256", "probe", "rights_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "enum": ["video", "image", "audio", "font", "subtitle", "effect", "model", "generated"]},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"},
        "probe": {"type": "object"},
        "rights_ref": {"type": "string", "minLength": 1},
        "proxy": {"type": "object"},
        "source": {"type": "object"}
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "duration_tick", "tracks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "duration_tick": {"$ref": "#/$defs/positiveInteger"},
        "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
        "markers": {"type": "array", "items": {"type": "object"}}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "order", "clips"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "enum": ["video", "audio", "subtitle", "data"]},
        "order": {"type": "integer"},
        "muted": {"type": "boolean"},
        "locked": {"type": "boolean"},
        "audio": {"type": "object", "additionalProperties": true},
        "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}}
      }
    },
    "trackingBinding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["version", "source_track_id", "source_clip_id", "asset_id", "source_sha256", "range", "observations", "offset", "scale_mode", "scale_multiplier", "rotation_mode", "base"],
      "properties": {
        "version": {"const": "timeline-canvas-v1"},
        "source_track_id": {"$ref": "#/$defs/id"},
        "source_clip_id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "range": {"type": "object", "additionalProperties": false, "required": ["start_seconds", "end_seconds"], "properties": {"start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}}},
        "observations": {"type": "array", "minItems": 1, "maxItems": 4000, "items": {"type": "object", "additionalProperties": false, "required": ["at_seconds", "x", "y", "width", "height", "confidence"], "properties": {"at_seconds": {"type": "number", "minimum": 0}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "offset": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": -1, "maximum": 1}, "y": {"type": "number", "minimum": -1, "maximum": 1}}},
        "scale_mode": {"enum": ["none", "roi"]},
        "scale_multiplier": {"type": "number", "exclusiveMinimum": 0, "maximum": 20},
        "rotation_mode": {"enum": ["none", "source"]},
        "base": {"type": "object", "additionalProperties": false, "required": ["scale", "rotation", "opacity", "opacity_keyframes"], "properties": {"scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 20}, "rotation": {"type": "number", "minimum": -3600, "maximum": 3600}, "opacity": {"type": "number", "minimum": 0, "maximum": 1}, "opacity_keyframes": {"type": "array", "items": {"type": "object"}}}}
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "timeline_start_tick", "duration_tick", "source_in_tick", "source_out_tick"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "sequence_id": {"$ref": "#/$defs/id"},
        "tracking_binding": {"$ref": "#/$defs/trackingBinding"},
        "rights_dependencies": {
          "type": "array",
          "items": {"type": "object", "required": ["rights_ref", "sha256"], "properties": {"rights_ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}
        },
        "timeline_start_tick": {"$ref": "#/$defs/nonNegativeInteger"},
        "duration_tick": {"$ref": "#/$defs/positiveInteger"},
        "source_in_tick": {"$ref": "#/$defs/nonNegativeInteger"},
        "source_out_tick": {"$ref": "#/$defs/positiveInteger"},
        "speed": {"type": "number", "exclusiveMinimum": 0},
        "speed_curve": {
          "oneOf": [
            {"type": "array", "items": {"$ref": "#/$defs/speedKeyframe"}},
            {"type": "object", "required": ["keyframes"], "properties": {"mode": {"type": "string"}, "keyframes": {"type": "array", "items": {"$ref": "#/$defs/speedKeyframe"}}, "audio_mode": {"type": "string"}}}
          ]
        },
        "freeze": {
          "type": "object",
          "additionalProperties": true,
          "required": ["at_tick", "duration_tick"],
          "properties": {
            "at_tick": {"$ref": "#/$defs/nonNegativeInteger"},
            "duration_tick": {"$ref": "#/$defs/positiveInteger"},
            "audio_mode": {"type": "string", "enum": ["silence", "continue"]}
          }
        },
        "transform": {"$ref": "#/$defs/transform"},
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframeTrack"}},
        "effects": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/effect"}]}},
        "transition_in": {"$ref": "#/$defs/transition"},
        "transition_out": {"$ref": "#/$defs/transition"},
        "crop": {"$ref": "#/$defs/crop"},
        "generator": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {"type": "string", "enum": ["text"]}
          },
          "required": ["type"]
        },
        "subtitle": {
          "type": "object",
          "properties": {"asset_time_base": {"type": "string", "enum": ["sequence", "clip"]}}
        },
        "audio": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "pan": {"oneOf": [{"type": "number", "minimum": -1, "maximum": 1}, {"type": "string", "minLength": 1}]}
          }
        },
        "blend": {"type": "object"},
        "mask": {"$ref": "#/$defs/mask"}
      },
      "oneOf": [{"required": ["asset_id"]}, {"required": ["sequence_id"]}, {"required": ["generator"]}]
    },
    "mask": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {"type": "string", "enum": ["none", "rectangle", "circle", "ellipse", "path", "polygon"]},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "minimum": 0, "maximum": 1},
        "height": {"type": "number", "minimum": 0, "maximum": 1},
        "cx": {"type": "number", "minimum": 0, "maximum": 1},
        "cy": {"type": "number", "minimum": 0, "maximum": 1},
        "radius": {"type": "number", "minimum": 0, "maximum": 1},
        "rx": {"type": "number", "minimum": 0, "maximum": 1},
        "ry": {"type": "number", "minimum": 0, "maximum": 1},
        "feather": {"type": "number", "minimum": 0, "maximum": 0.5},
        "invert": {"type": "boolean"},
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "object", "additionalProperties": true}
        },
        "curve_segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "object", "additionalProperties": true}
        },
        "curves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "object", "additionalProperties": true}
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
              {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}}
            ]
          }
        },
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframeTrack"}}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "direction": {"type": "string"},
        "auto_handle": {"type": "boolean"},
        "handle_policy": {"type": "string", "enum": ["manual", "auto"]},
        "version": {"type": "string"},
        "parameters": {"type": "object"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "parameters": {"type": "object", "additionalProperties": true},
        "scope": {"type": "string"},
        "enabled": {"type": "boolean"},
        "source": {"type": "object", "additionalProperties": true},
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframeTrack"}}
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "unit": {"type": "string", "enum": ["pixels", "pixel", "normalized", "relative"]},
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0},
        "fit": {"type": "string", "enum": ["fit", "fill", "stretch"]},
        "mode": {"type": "string", "enum": ["fit", "fill", "stretch"]},
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframeTrack"}}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "position": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        },
        "anchor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "x": {"type": "number", "minimum": 0, "maximum": 1},
            "y": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "anchor_x": {"type": "number", "minimum": 0, "maximum": 1},
        "anchor_y": {"type": "number", "minimum": 0, "maximum": 1},
        "scale": {"type": "number"},
        "rotation": {"type": "number"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "keyframeTrack": {
      "type": "object",
      "required": ["property", "keyframes"],
      "properties": {
        "property": {"type": "string", "minLength": 1},
        "default_value": {},
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["at_tick", "value", "interpolation"],
            "properties": {
              "at_tick": {"$ref": "#/$defs/nonNegativeInteger"},
              "value": {},
              "interpolation": {"type": "string", "enum": ["hold", "linear", "ease_in", "ease_out", "ease_in_out", "bezier"]},
              "control_points": {
                "oneOf": [
                  {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                  {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
                ]
              }
            }
          }
        }
      }
    },
    "speedKeyframe": {
      "type": "object",
      "required": ["at_tick", "speed"],
      "properties": {
        "at_tick": {"$ref": "#/$defs/nonNegativeInteger"},
        "speed": {"type": "number", "exclusiveMinimum": 0},
        "interpolation": {"type": "string", "enum": ["hold", "linear", "ease_in", "ease_out", "ease_in_out", "bezier"]},
        "control_points": {
          "oneOf": [
            {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
            {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
          ]
        }
      },
      "allOf": [{"if": {"required": ["interpolation"], "properties": {"interpolation": {"const": "bezier"}}}, "then": {"required": ["control_points"]}}]
    },
    "template": {
      "type": "object",
      "required": ["id", "version", "variables"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string"},
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
              "type": {"type": "string", "enum": ["any", "string", "number", "integer", "boolean", "asset", "color", "enum"]},
              "required": {"type": "boolean"},
              "default": {},
              "values": {"type": "array"},
              "choices": {"type": "array"},
              "enum": {"type": "array"},
              "min": {"type": "number"},
              "max": {"type": "number"},
              "min_length": {"type": "integer", "minimum": 0},
              "max_length": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": true
          }
        },
        "assets": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "sequence_id": {"$ref": "#/$defs/id"},
        "operations": {"type": "array", "items": {"type": "object"}},
        "changes": {"type": "array", "items": {"type": "object"}},
        "render": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "required": ["id", "path", "container"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string"},
        "container": {"type": "string", "enum": ["mp4", "webm", "mkv"]},
        "video": {"type": "object"},
        "audio": {"type": "object"},
        "target_platform": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cli_version": {"type": "string"},
        "engine_version": {"type": "string"},
        "model_versions": {"type": "array"},
        "input_hashes": {"type": "array"},
        "change_log": {"type": "array"}
      }
    }
  }
}
