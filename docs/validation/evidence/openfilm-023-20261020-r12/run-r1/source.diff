+    void sourcesApi.skills(projectId).then((skills) => { if (request === revision) changed(skills); });
+  };
+  events.addEventListener(SKILLS_CHANGED, refresh);
+  refresh();
+  return () => { ++revision; events.removeEventListener(SKILLS_CHANGED, refresh); };
