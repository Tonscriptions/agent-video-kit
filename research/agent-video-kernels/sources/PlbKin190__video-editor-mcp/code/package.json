{
  "name": "video-editor-mcp",
  "version": "0.1.0",
  "description": "A local, typed video editing workbench over MCP and ffmpeg.",
  "license": "Apache-2.0",
  "author": "Christian Verbrugge",
  "type": "module",
  "private": false,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "files": ["dist/src", "README.md", "LICENSE", "NOTICE"]
}
