{
  "id": "template.basic-vertical-ad",
  "version": "0.1.0",
  "variables": [
    {"name": "asset_id", "type": "asset", "required": true},
    {"name": "duration_tick", "type": "integer", "required": false, "default": 90000, "min": 1}
  ],
  "sequence_id": "seq_main",
  "operations": [
    {
      "op": "append_clip",
      "track_id": "track_video_1",
      "asset_id": "{{asset_id}}",
      "source_in_tick": 0,
      "source_out_tick": "{{duration_tick}}",
      "duration_tick": "{{duration_tick}}"
    }
  ]
}
