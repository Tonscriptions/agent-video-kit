+        source_out=source_in+90000
+        duration=int(Fraction(source_out-source_in)/speed)
+        if ramp:
+            with localcontext() as ctx:
+                ctx.prec=60
+                integral=Decimal(3).ln()
+                duration=int((integral*90000).to_integral_value())
