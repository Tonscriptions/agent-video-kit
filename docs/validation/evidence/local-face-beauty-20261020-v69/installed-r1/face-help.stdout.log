usage: ai-ad-editor face retouch [-h] [--format {json,text}]
                                 [--request-id REQUEST_ID]
                                 [--idempotency-key IDEMPOTENCY_KEY]
                                 [--dry-run] [--no-network]
                                 [--progress {none,jsonl}] --project PROJECT
                                 --asset-id ASSET_ID
                                 --derived-asset-id DERIVED_ASSET_ID
                                 --python-executable PYTHON_EXECUTABLE
                                 (--report REPORT |
                                 --recipe-from-asset RECIPE_FROM_ASSET)
                                 [--all-detected | --face-id FACE_ID]
                                 [--skin-smooth SKIN_SMOOTH]
                                 [--exposure-ev EXPOSURE_EV]
                                 [--face-slim FACE_SLIM]
                                 [--eye-enlarge EYE_ENLARGE]
                                 [--timeout TIMEOUT]
                                 [--cancel-file CANCEL_FILE]

options:
  -h, --help            show this help message and exit
  --format {json,text}  输出格式
  --request-id REQUEST_ID
  --idempotency-key IDEMPOTENCY_KEY
  --dry-run
  --no-network
  --progress {none,jsonl}
  --project PROJECT
  --asset-id ASSET_ID
  --derived-asset-id DERIVED_ASSET_ID
  --python-executable PYTHON_EXECUTABLE
  --report REPORT
  --recipe-from-asset RECIPE_FROM_ASSET
  --all-detected
  --face-id FACE_ID
  --skin-smooth SKIN_SMOOTH
  --exposure-ev EXPOSURE_EV
  --face-slim FACE_SLIM
  --eye-enlarge EYE_ENLARGE
  --timeout TIMEOUT
  --cancel-file CANCEL_FILE
