  "driver_source": "\"\"\"Developer diagnostic: robust same-canvas observation reuse, no model inference.\"\"\"\nfrom __future__ import annotations\nfrom datetime import datetime,timezone\nimport hashlib,json,subprocess,sys,time,warnings\nfrom pathlib import Path\nimport numpy as np\nfrom PIL import Image,ImageDraw,ImageFilter\nroot=Path(__file__).resolve().parents[2];sys.path.insert(0,str(root/'product/src'))\nfrom ai_ad_editor.media import ffmpeg_path\nfrom ai_ad_editor.runtime import configure_local_runtime\nconfigure_local_runtime()\nout=root/'workspace/repair-observed-plate-diagnostic-20261016';assert not out.exists();out.mkdir(parents=True)\ndef sha(p):return 'sha256:'+hashlib.sha256(Path(p).read_bytes()).hexdigest()\ndef sources():return {p.relative_to(root).as_posix():sha(p) for p in sorted([*root.joinpath('product/src').rglob('*.py'),*root.joinpath('product/tests').glob('*.py'),*root.joinpath('scripts').glob('*.py')])}\nbefore=sources();started=time.monotonic()\ndef observed_plate(rgb,forbidden,min_donors=3,max_mad=12.):\n assert rgb.dtype==np.uint8 and rgb.ndim==4 and rgb.shape[-1]==3 and forbidden.dtype==np.bool_ and forbidden.shape==rgb.shape[:3]\n count=np.sum(~forbidden,axis=0,dtype=np.int32);channels=[];spreads=[]\n with warnings.catch_warnings():\n  warnings.filterwarnings('ignore',message='All-NaN slice encountered')\n  for c in range(3):\n   values=rgb[:,:,:,c].astype(np.float32);values[forbidden]=np.nan\n   median=np.nanmedian(values,axis=0);spread=np.nanmedian(np.abs(values-median),axis=0)\n   channels.append(np.nan_to_num(median,nan=0.));spreads.append(np.nan_to_num(spread,nan=np.inf))\n plate=np.stack(channels,axis=2);mad=np.max(np.stack(spreads,axis=2),axis=2)\n valid=(count>=min_donors)&(mad<=max_mad)\n return plate,valid,count,mad\n# Independent truth and forbidden-input invariance; these are not product tests.\ny,x=np.indices((20,28));truth=np.stack([(x%5)*20+40,(y%4)*25+30,(x+y)%7*18+50],axis=2).astype(np.uint8)\nfixture=np.repeat(truth[None],8,axis=0);blocked=np.zeros(fixture.shape[:3],bool)\nfor i in range(8):\n blocked[i,5:12,i*3:i*3+4]=True;fixture[i][blocked[i]]=[255,0,0]\nplate,ok,_,_=observed_plate(fixture,blocked);assert ok.all();np.testing.assert_array_equal(plate,truth)\nchanged=fixture.copy();changed[blocked]=[0,255,255];other=observed_plate(changed,blocked);np.testing.assert_array_equal(plate,other[0]);np.testing.assert_array_equal(ok,other[1])\nblocked[:,8:11,10:13]=True;plate2,ok2,_,_=observed_plate(fixture,blocked);assert not ok2[8:11,10:13].any()\nfixture2=fixture.copy();fixture2[:,0,0,0]=np.arange(8,dtype=np.uint8)*30\nassert not observed_plate(fixture2,blocked,max_mad=1)[1][0,0]\nnew=json.loads((root/'workspace/repair-blend-20261016-lama-natural-v2/summary.json').read_text(encoding='utf-8-sig'))\nunion=json.loads((root/'workspace/sam2-smoke-20261016-natural-final/summary.json').read_text(encoding='utf-8-sig'))\nr=new['inpainting'];w,h=r['video']['width'],r['video']['height']\ndef decode(path):\n raw=subprocess.check_output([ffmpeg_path(),'-nostdin','-hide_banner','-loglevel','error','-i',str(path),'-an','-f','rawvideo','-pix_fmt','rgba','pipe:1'])\n return np.frombuffer(raw,np.uint8).reshape(-1,h,w,4)\nsource=decode(r['source']['path']);target=decode(r['mask']['path']);both=decode(union['matting']['output']);baseline=decode(r['output'])\nassert source.shape==both.shape==target.shape==baseline.shape==(32,288,512,4)\nnp.testing.assert_array_equal(source[:,:,:,:3],both[:,:,:,:3])\ndef grow(mask,radius):return np.array([np.asarray(Image.fromarray(s.astype(np.uint8)*255).filter(ImageFilter.MaxFilter(2*radius+1)))!=0 for s in mask])\nselected=grow(target[:,:,:,3]>127.5,4);forbidden=grow(both[:,:,:,3]>127.5,8)|selected\nplate,eligible,counts,mad=observed_plate(source[:,:,:,:3],forbidden)\nresult=baseline.copy();copied=selected&eligible[None]\nfor i in range(32):result[i,copied[i],:3]=np.rint(plate[copied[i]]).astype(np.uint8)\nnp.testing.assert_array_equal(result[~selected],source[~selected]);np.testing.assert_array_equal(result[:,:,:,3],source[:,:,:,3])\nnp.savez_compressed(out/'diagnostic-rgba.npz',frames=result)\nindices=[0,4,8,12,13,16,17,21,25,26,29,30,31];contacts=[]\nfor part,group in enumerate([indices[:7],indices[7:]],1):\n sheet=Image.new('RGB',(1280,len(group)*166),'#20232a');draw=ImageDraw.Draw(sheet)\n for row,i in enumerate(group):\n  views=[('source',source[i,:,:,:3]),('target mask',np.repeat(selected[i,:,:,None],3,axis=2).astype(np.uint8)*255),('LaMa harmonic',baseline[i,:,:,:3]),('observed reuse',result[i,:,:,:3]),('copied / white',np.repeat(copied[i,:,:,None],3,axis=2).astype(np.uint8)*255)]\n  for col,(label,pixels) in enumerate(views):\n   sheet.paste(Image.fromarray(pixels).resize((256,144)),(col*256,row*166+22));draw.text((col*256+4,row*166+4),f'{label} / {i}',fill='white')\n p=out/f'contact-{part}.png';sheet.save(p);contacts.append({'path':p.relative_to(root).as_posix(),'sha256':sha(p),'frames':group})\nafter=sources();assert before==after\nstats={'checked_at_utc':datetime.now(timezone.utc).isoformat(),'status':'diagnostic-completed-quality-unaccepted','seconds':time.monotonic()-started,\n 'algorithm':'same-output-canvas-temporal-median-excluding-dilated-union-foreground','minimum_observed_donors':3,'maximum_median_absolute_deviation_8bit':12.,'union_mask_grow':8,'repair_mask_grow':4,\n 'independent_synthetic_checks':['textured_static_ground_recovered_exactly','forbidden_source_rgb_invariant','never_observed_region_rejected','unstable_color_rejected'],\n 'source':{'path':r['source']['path'],'sha256':sha(r['source']['path'])},'target_mask':{'path':r['mask']['path'],'sha256':sha(r['mask']['path'])},'union_foreground_mask':{'path':union['matting']['output'],'sha256':sha(union['matting']['output']),'object_ids':union['matting']['prompt_plan']['object_ids'],'decoded_source_rgb_exact':True},\n 'masked_pixels':int(selected.sum()),'pixels_using_observed_background':int(copied.sum()),'observed_coverage_fraction':float(copied.sum()/selected.sum()),'eligible_canvas_pixels':int(eligible.sum()),\n 'outside_rgb_changed_pixels':0,'source_alpha_exact':True,'fallback':'existing_registered_LaMa_harmonic_output','output_npz_sha256':sha(out/'diagnostic-rgba.npz'),'contact_sheets':contacts,\n 'product_integration':False,'formal_model_runs_added':0,'camera_motion_compensation':False,'depth_or_surface_deformation_modeling':False,'natural_truth_available':False,'natural_psnr_reported':False,'continuous_playback_reviewed':False,'full_jianying_parity_accepted':False,\n 'source_sha256_before':before,'source_sha256_after':after,'implementation_edited_during_run':False,'driver_sha256':sha(__file__),'driver_source':Path(__file__).read_text(encoding='utf-8-sig')}\n(out/'summary.json').write_text(json.dumps(stats,ensure_ascii=False,indent=2)+'\\n',encoding='utf-8',newline='\\n')\nprint(json.dumps({k:stats[k] for k in ['status','seconds','masked_pixels','pixels_using_observed_background','observed_coverage_fraction','formal_model_runs_added','implementation_edited_during_run']}))\n",
