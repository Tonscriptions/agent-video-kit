{"name":"capcut_add_transition","description":"Adds a transition effect (e.g. Dissolve, Fade to Black, Fade to White, Zoom In) between clips on a video track.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"duration_seconds":{"default":0.5,"description":"Transition duration in seconds (default 0.5s).","type":"number"},"project_name_or_id":{"description":"Target project name or ID.","type":"string"},"segment_id":{"description":"UUID of the video segment to attach the transition to.","type":"string"},"transition_name":{"default":"Dissolve","description":"Name of the transition effect.","enum":["Dissolve","Fade to Black","Fade to White","Slide Left","Zoom In"],"type":"string"}},"required":["project_name_or_id","segment_id"],"type":"object"}}